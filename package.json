{
  "name": "3dmviewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser 3D product studio — load a model from disk, a URL or a Google Drive link; fix its orientation, recolour its materials, light it, and export one image per colourway.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "build": "vite build",
    "preview": "vite preview",
    "preview:https": "vite preview --host --mode https",
    "test": "node test/links.mjs && node test/smoke.mjs && node test/stats.mjs && node test/materials.mjs && node test/remote.mjs",
    "test:links": "node test/links.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:stats": "node test/stats.mjs",
    "test:materials": "node test/materials.mjs",
    "test:remote": "node test/remote.mjs",
    "test:inspect": "node test/inspect.mjs",
    "test:errors": "node test/errors.mjs",
    "test:ui": "node test/ui-shot.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "playwright": "^1.63.0",
    "vite": "^7.1.5"
  }
}
