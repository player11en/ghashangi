{
  "name": "ghashangi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser 3D model studio — load a model from disk, a URL or a Google Drive link; fix its orientation, recolour its materials, light it, style it, and export one image per colourway or a recorded camera move.",
  "license": "MIT",
  "author": "player11en",
  "repository": {
    "type": "git",
    "url": "https://github.com/player11en/ghashangi.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host --mode https",
    "check": "node scripts/check-refs.mjs && node scripts/check-dom-ids.mjs",
    "prebuild": "npm run check",
    "build": "vite build",
    "build:maps": "vite build --mode maps",
    "assets": "node scripts/compress-assets.mjs",
    "preview": "vite preview",
    "preview:https": "vite preview --host --mode https",
    "test": "node test/links.mjs && node test/smoke.mjs && node test/stats.mjs && node test/animation.mjs && node test/render.mjs && node test/materials.mjs && node test/camera-path.mjs && node test/remote.mjs",
    "test:links": "node test/links.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:stats": "node test/stats.mjs",
    "test:animation": "node test/animation.mjs",
    "test:render": "node test/render.mjs",
    "test:materials": "node test/materials.mjs",
    "test:camera-path": "node test/camera-path.mjs",
    "test:remote": "node test/remote.mjs",
    "test:inspect": "node test/inspect.mjs",
    "test:errors": "node test/errors.mjs",
    "test:ui": "node test/ui-shot.mjs",
    "images": "node scripts/build-images.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.5"
  }
}
